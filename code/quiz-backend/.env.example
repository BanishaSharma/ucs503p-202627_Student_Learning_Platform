# ============================================================
# ShikshaSetu Backend — Environment Variables Template
# Copy this file to .env and configure local values.
# NEVER commit real credentials or .env to version control.
# ============================================================

PORT=5000
NODE_ENV=development

# Option A: Full Connection URI
# DATABASE_URL=postgresql://postgres:password@localhost:5432/shikshasetu_quiz

# Option B: Individual Connection Parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=shikshasetu_quiz
